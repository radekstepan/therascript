# File: .env.example (Root)
# --- Updated example file ---
# ==========================================================
# Therascript Environment Variables (.env.example)
# ==========================================================
#
# Copy this file to .env.api.dev, .env.api.prod, .env.worker.dev
# and adjust the values accordingly.
#
# ----------------------------------------------------------

# === General Server Configuration ===
# The port the API server will listen on
PORT=3001

# Host the API binds to. 0.0.0.0 to accept connections on any interface
# (Tailscale, LAN, localhost). Use 127.0.0.1 to keep it loopback-only.
HOST=0.0.0.0

# Node environment ('development' or 'production')
NODE_ENV=development

# URL of the frontend application for CORS policy
CORS_ORIGIN=http://localhost:3002

# --- Redis Configuration (for API and Worker) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Whisper Configuration ---
WHISPER_API_URL=http://localhost:8000
# NOTE: WHISPER_MODEL is retired — the service always uses Parakeet
# (PARAKEET_MODEL_ID). Kept here only because usage logging reads it.
WHISPER_MODEL=parakeet-tdt-0.6b-v2
WHISPER_POLLING_TIMEOUT_MS=1800000
# Parakeet model id (NeMo). Long audio is chunked with overlap; see
# PARAKEET_CHUNK_SEC / PARAKEET_CHUNK_OVERLAP_SEC.
PARAKEET_MODEL_ID=nvidia/parakeet-tdt-0.6b-v2
PARAKEET_CHUNK_SEC=300
PARAKEET_CHUNK_OVERLAP_SEC=10
# fp16 on CUDA halves Parakeet weights (~2.4GB -> ~1.3GB). Set 0 to force fp32.
PARAKEET_FP16=1
# Diarization windows (overlap aligns speaker labels across the boundary).
# 0 disables chunking (legacy single-pass over the full audio — OOM-prone on
# hour-long sessions).
DIARIZATION_CHUNK_SEC=600
DIARIZATION_CHUNK_OVERLAP_SEC=30
# LLM API endpoint the transcription container calls to evict the chat model
# before a job (VRAM handoff). host.docker.internal resolves via the compose
# extra_hosts mapping on Linux and natively on Docker Desktop.
LLM_UNLOAD_URL=http://host.docker.internal:3001/api/llm/unload
# Hugging Face token for pyannote diarization models.
# Source of truth for Whisper is the root .env consumed by docker compose.
# Keep this value aligned across env files if you duplicate it.
HF_TOKEN=
# --- Elasticsearch Configuration ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Database & File Storage Configuration ---
# IMPORTANT: These paths are relative to the package directory that uses them (api or worker)
DB_PATH=./data/therapy-analyzer.sqlite
DB_UPLOADS_DIR=./data/uploads
# Encrypted vault directory. Use a separate vault per database file.
VAULT_DIR=./data/vault

# --- Upload Configuration (API only) ---
UPLOAD_MAX_FILE_SIZE=1g
