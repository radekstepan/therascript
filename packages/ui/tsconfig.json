{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES6", // Target browsers
    "module": "ESNext", // For Webpack/modern browsers
    "jsx": "react-jsx", // React specific
    "outDir": "./dist/", // Output managed by Webpack
    "rootDir": "./src",
    "moduleResolution": "node", // Standard for frontend builds
    "isolatedModules": true,
    "noEmit": false,
    // App bundle, not a library: no workspace package consumes @therascript/ui
    // types, so skip declaration emit (ts-loader was writing .d.ts files into
    // dist and paying the declaration cost on every production build).
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "baseUrl": "./src", // For '@/' alias
    "paths": {
      // Keep path alias if used
      "@/*": ["*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
