{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      // The fork bundles index.d.ts but its `exports` map has no `types`
      // condition, so NodeNext resolution cannot see it. Pin the internal
      // resolution here; the public boundary uses DbDatabase (see
      // types.ts), so consumers never resolve this specifier.
      "better-sqlite3-multiple-ciphers": [
        "../../node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
