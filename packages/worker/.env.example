# Worker Service Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Hugging Face Token (required for Whisper diarization via pyannote)
HF_TOKEN=your_token_here

# Whisper Configuration
WHISPER_API_URL=http://localhost:8000
# Retired — the transcription service always uses Parakeet
# (PARAKEET_MODEL_ID). Kept only because usage logging reads it.
WHISPER_MODEL=parakeet-tdt-0.6b-v2
