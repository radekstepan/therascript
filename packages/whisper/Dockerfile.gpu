# GPU-enabled Dockerfile for transcription - uses NVIDIA CUDA.
# Stack: Parakeet (NeMo) ASR + pyannote Community-1 diarization.
# Parakeet FP16 is ~1.3GB VRAM; Community-1 diarization shares the GPU.
FROM nvidia/cuda:12.6.0-cudnn9-runtime-ubuntu22.04

WORKDIR /app

# Install system dependencies + Python
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    git \
    supervisor \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch with CUDA support, then the pinned runtime deps.
# torchcodec cu126 wheel required by pyannote.audio 4.x audio I/O.
COPY packages/whisper/requirements.txt packages/whisper/constraints-cu126.txt ./
RUN pip3 install --no-cache-dir torch==2.8.0+cu126 torchaudio==2.8.0+cu126 torchcodec==0.7.0+cu126 --index-url https://download.pytorch.org/whl/cu126 && \
    pip3 install --no-cache-dir -c constraints-cu126.txt -r requirements.txt

# Install Node.js (for the Express wrapper)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g yarn

# Copy Node dependencies
COPY packages/whisper/package.json ./
COPY yarn.lock ./
RUN yarn install --production --frozen-lockfile

# Copy source code
COPY packages/whisper/. .

# Expect dist to be prebuilt from the host workspace (yarn build:whisper)
RUN test -f /app/dist/server.js

# Setup Directories
RUN mkdir -p /app/temp_inputs /app/temp_outputs

# Setup Supervisor
COPY packages/whisper/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 8000 8001

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
